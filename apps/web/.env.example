# Copy to .env.local for local development. Validated in lib/env.ts.
# Anything prefixed NEXT_PUBLIC_ is shipped to the browser — never put secrets there.

NEXT_PUBLIC_SITE_NAME=Restaurant

# Optional; Sentry is off when empty.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Server-only: where the Express API listens (used by the dev /api rewrite and server-side fetches).
API_INTERNAL_URL=http://localhost:4000
