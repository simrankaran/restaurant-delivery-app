# Copy to .env for local development. Validated at startup by src/config/env.ts.
NODE_ENV=development
PORT=4000

# docker compose (single-node replica set, needed for transactions)
MONGO_URI=mongodb://localhost:27017/restaurant?directConnection=true
REDIS_URL=redis://localhost:6379

# The web app's origin; CORS allows only this.
WEB_ORIGIN=http://localhost:3000

# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=debug

# Number of reverse proxies in front of the API (1 behind Nginx in production, 0 locally).
TRUST_PROXY=0

# Optional; Sentry is off when empty.
SENTRY_DSN=
