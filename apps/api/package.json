{
  "name": "@restaurant/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,worker -c blue,magenta \"pnpm run dev:server\" \"pnpm run dev:worker\"",
    "dev:server": "tsx watch --import ./src/instrument.ts src/server.ts",
    "dev:worker": "tsx watch --import ./src/instrument.ts src/worker.ts",
    "build": "tsup",
    "start": "node --import ./dist/instrument.js dist/server.js",
    "start:worker": "node --import ./dist/instrument.js dist/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@restaurant/shared": "workspace:*",
    "@sentry/node": "^11.17.0",
    "bullmq": "^6.7.8",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "ioredis": "^6.1.0",
    "mongoose": "^9.13.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.7",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15"
  }
}
